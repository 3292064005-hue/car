<?xml version="1.0"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.2.0</version>
  <description>Bringup package for the inspection robot.</description>
  <maintainer email="maintainers@inspection-robot.invalid">Inspection Robot Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_bridge</exec_depend>
  <exec_depend>robot_control</exec_depend>
  <exec_depend>robot_decision</exec_depend>
  <exec_depend>robot_voice</exec_depend>
  <exec_depend>robot_vision</exec_depend>
  <exec_depend>robot_monitor</exec_depend>
  <exec_depend>robot_teleop</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
