<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="inspection_robot">
  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_separation" value="0.320"/>
  <xacro:property name="body_length" value="0.460"/>
  <xacro:property name="body_width" value="0.310"/>
  <xacro:property name="body_height" value="0.180"/>
  <xacro:property name="camera_height" value="0.240"/>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.0900" rpy="0 0 0"/>
      <mass value="11.0000"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0" iyy="0.16" iyz="0.0" izz="0.18"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${body_height/2.0}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_height/2.0}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
  </link>
  <link name="left_wheel_link"/>
  <link name="right_wheel_link"/>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.1600 0.0650" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.1600 0.0650" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="camera_link"/>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 ${camera_height}" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>
  <joint name="imu_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1440" rpy="0 0 0"/>
  </joint>
  <link name="battery_link"/>
  <joint name="battery_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="-0.08 0 0.0900" rpy="0 0 0"/>
  </joint>
</robot>
