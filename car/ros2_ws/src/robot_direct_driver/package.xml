<?xml version="1.0"?>
<package format="3">
  <name>robot_direct_driver</name>
  <version>0.2.0</version>
  <description>Dedicated direct-driver lane package for inspection robot command/state authority.</description>
  <maintainer email="maintainers@inspection-robot.invalid">Inspection Robot Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_msgs</exec_depend>
  <exec_depend>robot_utils</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>robot_hardware_interface</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
